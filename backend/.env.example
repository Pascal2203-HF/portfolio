# Par défaut: SQLite (aucune installation nécessaire, fonctionne directement sous Windows)
DATABASE_URL=sqlite:///./portfolio.db

# Pour utiliser PostgreSQL, décommentez et adaptez la ligne suivante :
# DATABASE_URL=postgresql://postgres:motdepasse@localhost:5432/portfolio_db

SECRET_KEY=change-this-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=120

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
